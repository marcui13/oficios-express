{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "POSTGRES_DATABASE_URL",
    "POSTGRES_URL",
    "POSTGRES_PRISMA_DATABASE_URL",
    "JWT_SECRET",
    "NEXT_PUBLIC_APP_NAME",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
